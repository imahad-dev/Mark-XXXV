.env
config/api_keys.json
__pycache__/
*.pyc

# ChromaDB local vector store (large binary files, user-specific)
memory/chroma_db/

# Migration flag
memory/.vector_migrated

# Vosk model (downloaded at runtime)
core/vosk_model/

# Biometric auth artifacts (NEVER commit these)
core/auth/golden_signature.npy
core/auth/master.key
core/auth/recovery/
core/auth/models/
.env.encrypted
.env.backup
core/auth/boot.env.tmp
core/auth/lockout.json

# Graphify analysis output (generated, contains absolute paths)
graphify-out/
.graphify_root

# Runtime session transcripts
session_*.jsonl

# SQLite WAL/journal sidecars (runtime, never commit)
*.db
*.db-shm
*.db-wal
*.db-journal

# Browser profile (runtime, machine-specific)
jarvis_profile/
