memory/.vector_migrated

# Vosk model (downloaded at runtime)
core/vosk_model/

# Biometric auth artifacts (NEVER commit these)
core/auth/golden_signature.npy
core/auth/master.key
core/auth/recovery/
core/auth/models/
.env.encrypted
.env.backup
core/auth/boot.env.tmp
