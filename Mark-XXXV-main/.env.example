# .env.example - copy to .env and fill in your values

# REQUIRED (primary key)
GEMINI_API_KEY=your_gemini_key_here

# MULTI-KEY ROTATION (comma-separated, optional — prevents quota exhaustion)
# System auto-rotates to next key when hitting 429 rate limits
GEMINI_API_KEYS=key1,key2,key3

# OPTIONAL - leave blank to disable feature
GROQ_API_KEY=
OPENWEATHER_API_KEY=
ELEVENLABS_API_KEY=
# Voice ID for Ultron persona (default: Daniel deep male voice)
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# TELEGRAM REMOTE CONTROL (optional)
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (get from @userinfobot)
TELEGRAM_ALLOWED_USER_ID=

# TUNING
CLAP_RMS_THRESHOLD=4000
AUDIO_DEVICE_INDEX=0
FALLBACK_ENABLED=true
DEBUG_MODE=false

# INTELLIGENCE ROUTER — zero-credit specialist APIs
# Get free APP_ID at https://developer.wolframalpha.com/
WOLFRAM_APP_ID=
# Ollama local LLM (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# OS-LEVEL SYSTEM (Phase 1+)
# Screen Intelligence — continuous screen awareness (CPU-based, event-driven)
SCREEN_INTELLIGENCE_ENABLED=false
SCREEN_CAPTURE_INTERVAL=30
# Workspace Restore — remember window positions across sessions
WORKSPACE_RESTORE_ENABLED=true
# Multi-agent concurrency limit (start at 2, bump to 3 after testing)
MAX_CONCURRENT_AGENTS=2
# Ambient mode — passive context awareness (<1% CPU)
AMBIENT_MODE_ENABLED=false

# PHASE 3 — Document Intelligence (background file indexing + semantic search)
DOC_INTELLIGENCE_ENABLED=false
# Debounce delay for file.modified events (seconds, prevents redundant re-indexing)
DOC_INTEL_DEBOUNCE_SEC=2.0
# Max files to index during initial boot crawl (remaining queued at low priority)
DOC_INTEL_MAX_FILES_ON_BOOT=100

# PHASE 3 — Communication (Email + Calendar)
# Default: local SQLite mock. Auto-upgrades to Outlook/SMTP when credentials detected.
COMMUNICATION_ENABLED=false
